{
  "info": {
    "name": "Distributed Order Engine Verification Suite",
    "schema": "https://getpostman.com"
  },
  "item": [
    {
      "name": "Execute Successful Order Placement Request",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"a3b4c5d6-e7f8-90a1-b2c3-d4e5f6a7b8c9\",\n    \"amount\": 199.99\n}"
        },
        "url": { "raw": "http://localhost:8081/api/orders" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Verify Order Pipeline Responds With HttpStatus 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Verify Cache-aside Ingestion Architecture Execution Latency Under 15ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(15);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Trigger Dead Letter Queue Logic Pipeline Validation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"TRIGGER_RESILIENCE_DLQ-e7f8-90a1-b2c3-d4e5f6a7b8c9\",\n    \"amount\": 10.00\n}"
        },
        "url": { "raw": "http://localhost:8081/api/orders" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order Successfully Logged In ACID Layer Wrapper', function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
